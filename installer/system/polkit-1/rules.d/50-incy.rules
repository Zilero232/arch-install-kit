// INCY VPN: connect without a password prompt. https://polkit.pages.freedesktop.org/polkit/polkit.8.html
// The helper runs whatever binary it is given as root, so only the exact calls the
// INCY app makes are allowed: the bundled xray and paths under /var/tmp/incy-xray/.
// Anything else still asks for the password.
// The state dir is chosen by INCY and lives in world-writable /var/tmp, so any local user could
// put files there; that is why the rule also requires an active local session of a wheel user.

// --- Allowed calls ---
// incy-bin ships the helper as a symlink; pkexec resolves it, finds no policy for the real path
// and falls back to the generic org.freedesktop.policykit.exec action, so both paths and both
// actions are recognised here
var INCY_HELPER = "/usr/lib/incy/incy-helper-linux.sh";
var INCY_HELPER_REAL = "/opt/incy/lib/app/resources/bin/incy-helper-linux.sh";
var INCY_HELPERS = [INCY_HELPER, INCY_HELPER_REAL];
var INCY_XRAY = "/opt/incy/lib/app/resources/bin/xray";
var INCY_STATE_DIR = "/var/tmp/incy-xray/";
var INCY_COMMANDS = [
    "start-xray-tun", "stop-xray-tun", "teardown",
    "setup-routes", "setup-routes-dns", "cleanup-routes",
    "dns-set", "dns-restore",
    "standalone-up", "standalone-apply", "standalone-down"
];

// Path arguments must be the bundled xray or live under the state dir; other
// arguments (interface names, marks, IPs, CIDRs) must be plain tokens.
function incyArgIsSafe(arg) {
    if (arg.indexOf("..") !== -1) {
        return false;
    }
    if (arg.charAt(0) === "/") {
        return arg === INCY_XRAY || arg.indexOf(INCY_STATE_DIR) === 0;
    }
    return /^[A-Za-z0-9_.,:\/~-]+$/.test(arg);
}

function incyCallIsSafe(commandLine) {
    var argv = commandLine.split(" ");
    if (INCY_HELPERS.indexOf(argv[0]) === -1 || INCY_COMMANDS.indexOf(argv[1]) === -1) {
        return false;
    }
    // start-xray-tun's first argument is the binary it runs as root
    if (argv[1] === "start-xray-tun" && argv[2] !== INCY_XRAY) {
        return false;
    }
    return argv.slice(2).every(incyArgIsSafe);
}

// --- Rule ---
// The INCY action, or the generic pkexec action for exactly the INCY helper
function isIncyAction(action) {
    if (action.id === "cc.incy.vpn.run-helper") {
        return true;
    }
    return action.id === "org.freedesktop.policykit.exec"
        && INCY_HELPERS.indexOf(action.lookup("program")) !== -1;
}

polkit.addRule(function (action, subject) {
    if (!isIncyAction(action)) {
        return polkit.Result.NOT_HANDLED;
    }
    if (!subject.local || !subject.active || !subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }
    if (incyCallIsSafe(action.lookup("command_line") || "")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
