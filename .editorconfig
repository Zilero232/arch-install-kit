# Indentation and line endings per file type. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{sh,bash,bats,fish,lua,rasi,toml,conf,rules}]
indent_size = 4
max_line_length = 100

# Written by the apps themselves or kept as upstream ships them
[{dotfiles/.config/swaync/config.json,dotfiles/.config/wlogout/layout,dotfiles/.config/Thunar/uca.xml}]
indent_style = tab

[{dotfiles/.config/ranger/**,LICENSE}]
insert_final_newline = unset

[*.md]
trim_trailing_whitespace = false

[{*.lock,bun.lock}]
insert_final_newline = false
