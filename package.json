{
  "name": "arch-install-kit",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Arch Linux + Hyprland setup installed with one command: modular installer, package groups and Kanagawa-themed dotfiles",
  "keywords": [
    "arch-linux",
    "archinstall",
    "hyprland",
    "wayland",
    "dotfiles",
    "installer",
    "waybar",
    "rofi",
    "fish",
    "kanagawa"
  ],
  "homepage": "https://github.com/Zilero232/arch-install-kit#readme",
  "bugs": {
    "url": "https://github.com/Zilero232/arch-install-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/arch-install-kit.git"
  },
  "license": "MIT",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "commit": "czg",
    "lint": "shellcheck -x $(git ls-files '*.sh')",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "commitlint-config-gitmoji": "^2.3.1",
    "czg": "^1.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "shellcheck": "^4.1.0",
    "vitepress": "^1.6.4"
  }
}
