{
  "name": "arch-install-kit",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Arch Linux + Hyprland setup installed with one command: modular installer, package groups and Kanagawa-themed dotfiles",
  "keywords": [
    "arch-linux",
    "archinstall",
    "hyprland",
    "wayland",
    "dotfiles",
    "installer",
    "waybar",
    "rofi",
    "fish",
    "kanagawa"
  ],
  "homepage": "https://github.com/Zilero232/arch-install-kit#readme",
  "bugs": {
    "url": "https://github.com/Zilero232/arch-install-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/arch-install-kit.git"
  },
  "license": "MIT",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "commit": "czg",
    "lint": "shellcheck -x $(git ls-files '*.sh' '*.bash' '*.bats')",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spell": "cspell --no-progress \"docs/**/*.md\" \"*.md\" \".github/*.md\"",
    "test": "bun test tests/ && bats tests/bats && lua tests/lua/layout_switch_test.lua",
    "test:packages": "tests/packages.sh",
    "test:all": "bun run test && bun run test:packages",
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "ajv": "^8.20.0",
    "bats": "^1.13.0",
    "bats-assert": "^2.2.4",
    "bats-support": "^0.3.0",
    "commitlint-config-gitmoji": "^2.3.1",
    "cspell": "^10.4.0",
    "czg": "^1.14.0",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitepress": "^1.6.4"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint-staged": {
    "*.{sh,bash,bats}": "shellcheck -x",
    "*.{md,json,jsonc,yml,yaml,mjs,ts,mts,vue,css}": "prettier --write"
  },
  "commitlint": {
    "extends": [
      "gitmoji"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        100
      ],
      "scope-enum": [
        2,
        "always",
        [
          "installer",
          "packages",
          "hypr",
          "waybar",
          "rofi",
          "shell",
          "dotfiles",
          "scripts",
          "login",
          "docs",
          "tooling",
          "deps",
          "tests",
          "theme",
          "system",
          "ci"
        ]
      ]
    },
    "prompt": {
      "useEmoji": true,
      "emojiAlign": "left",
      "allowCustomScopes": false,
      "allowEmptyScopes": true
    }
  },
  "cspell": {
    "version": "0.2",
    "language": "en",
    "ignorePaths": [
      "node_modules",
      "bun.lock",
      "assets",
      "dotfiles/.config/ranger/scope.sh"
    ],
    "words": [
      "activewindow",
      "airscan",
      "Alexandr",
      "amdgpu",
      "anydesk",
      "archinstall",
      "archiso",
      "archlinux",
      "Artemev",
      "aurlist",
      "automount",
      "autorepeat",
      "autosnap",
      "backgrounded",
      "batsignal",
      "blueman",
