{
  "name": "arch-install-kit",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Arch Linux + Hyprland setup installed with one command: modular installer, package groups and Kanagawa-themed dotfiles",
  "keywords": [
    "arch-linux",
    "archinstall",
    "hyprland",
    "wayland",
    "dotfiles",
    "installer",
    "waybar",
    "rofi",
    "fish",
    "kanagawa"
  ],
  "homepage": "https://github.com/Zilero232/arch-install-kit#readme",
  "bugs": {
    "url": "https://github.com/Zilero232/arch-install-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/arch-install-kit.git"
  },
  "license": "MIT",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "commit": "czg",
    "lint": "shellcheck -x $(git ls-files '*.sh' '*.bash' '*.bats')",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spell": "cspell --no-progress \"docs/**/*.md\" \"*.md\"",
    "test": "bun test tests/ && bats tests/bats && lua tests/lua/layout_switch_test.lua",
    "test:packages": "tests/packages.sh",
    "test:all": "bun run test && bun run test:packages",
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "ajv": "^8.20.0",
    "bats": "^1.13.0",
    "bats-assert": "^2.2.4",
    "bats-support": "^0.3.0",
    "commitlint-config-gitmoji": "^2.3.1",
    "cspell": "^9.8.0",
    "czg": "^1.14.0",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "shellcheck": "^4.1.0",
    "svgo": "^4.1.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitepress": "^1.6.4"
  }
}
