{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "transient_prompt": {
    "template": "  ❯❯ {{ .AbsolutePWD }} : ",
    "foreground": "p:color15",
    "background": "transparent",
    "newline": true
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:color15",
          "template": "\n╭─"
        },
        {
          "type": "session",
          "style": "diamond",
          "foreground": "p:color15",
          "background": "p:color13",
          "leading_diamond": "",
          "template": "{{ .UserName }}"
        },
        {
          "type": "root",
          "style": "powerline",
          "foreground": "#ff5555",
          "background": "p:color13",
          "powerline_symbol": "",
          "template": "󱐋"
        },
        {
          "type": "os",
          "style": "powerline",
          "foreground": "p:color15",
          "background": "p:color13",
          "powerline_symbol": "",
          "template": "{{ .Icon }}  "
        },
        {
          "type": "path",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "p:color10",
          "trailing_diamond": "",
          "template": " 󰉖 {{ path .Path .Location }}",
          "options": {
            "style": "full"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "git",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "#ffb86c",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " ({{ url .UpstreamIcon .UpstreamURL }} {{ url .HEAD .UpstreamURL }}){{ if gt .Ahead 0 }}<#50fa7b> +{{ .Ahead }}</>{{ end }}{{ if gt .Behind 0 }}<#ff5555> -{{ .Behind }}</>{{ end }}{{ if .Working.Changed }}<p:color15>  {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }}<p:color15>  {{ .Staging.String }}</>{{ end }}",
          "options": {
            "branch_icon": ""
          }
        },
        {
          "type": "node",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "#50fa7b",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .Full }}"
        },
        {
          "type": "npm",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "#ff5555",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .Full }}",
          "options": {
            "display_mode": "files",
            "extensions": [
              "package-lock.json"
            ]
          }
        },
        {
          "type": "pnpm",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "#ffb86c",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "󰋁 {{ .Full }}",
          "options": {
            "display_mode": "files",
            "extensions": [
              "pnpm-lock.yaml"
            ]
          }
        },
        {
          "type": "python",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "#50fa7b",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .Full }}",
          "options": {
            "display_mode": "files"
          }
        },
        {
          "type": "java",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "#ff79c6",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .Full }}"
        },
        {
          "type": "php",
          "style": "diamond",
          "foreground": "p:color15",
          "background": "#6272a4",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .Full }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:color15",
          "template": "╰─ ❯❯"
        }
      ],
      "newline": true
    }
  ],
  "palette": {
    "color0": "#1a110f",
    "color10": "#ffb59d",
    "color13": "#390c00",
    "color15": "#f1dfda"
  }
}
