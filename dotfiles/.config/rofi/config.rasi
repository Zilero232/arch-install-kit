/* Rofi launcher (Super+D). Theme and colors: colors.rasi; pickers use menu.rasi
 * https://github.com/davatorium/rofi/blob/next/doc/rofi.1.markdown */

@theme "~/.config/rofi/colors.rasi"

configuration {
    modes: "run,drun,window";
    terminal: "alacritty";

    /* Look */
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus-Dark"; /* same as GTK */
    drun-display-format: "{name}";
    location: 0; /* center */

    /* Mode switcher labels */
    sidebar-mode: true;
    display-drun: "󰀻 Apps";
    display-run: "󰆍 Run";
    display-window: "󰖯 Window";

    disable-history: false;
}
