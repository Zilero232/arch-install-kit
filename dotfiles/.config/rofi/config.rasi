/* Rofi launcher (Super+D, Super+V). Theme and colours: colors.rasi
 * https://github.com/davatorium/rofi/blob/next/doc/rofi.1.markdown */

@theme "~/.config/rofi/colors.rasi"

configuration {
    modes: "run,drun,window";
    terminal: "alacritty";

    /* Look */
    font: "JetBrainsMono Nerd Font 18";
    show-icons: true;
    icon-theme: "Kanagawa"; /* kanagawa-icon-theme-git, same as GTK */
    drun-display-format: "{name}";
    location: 0; /* centre */

    /* Mode switcher labels */
    sidebar-mode: true;
    display-drun: " Apps";
    display-run: " Run";
    display-window: " Window";

    disable-history: false;
}
