/* Rofi theme: Kanagawa colours, fullscreen app grid. */
* {
    bg: #1f1f23ee;            // sumiInk, translucent
    bg-alt: #2a2a37;          // sumiInk4
    bg-selected: #7aa89f;     // waveAqua2
    fg: #dcd7ba;              // fujiWhite
    fg-alt: #727169;          // fujiGray
    fg-selected: #1f1f23;     // sumiInk

    /* Reset */
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

/* Window style */
window {
    fullscreen: true;
    transparency: "real";
    background-color: @bg;
    padding: 90px 150px;
}

/* Main container */
mainbox {
    padding: 20px;
    background-color: transparent;
}

/* Search bar */
inputbar {
    background-color: @bg-alt;
    padding: 12px;
    margin: 0px 0px 20px 0px;
    border-radius: 8px;
    font: "JetBrainsMono Nerd Font 20";
    children: [prompt, entry];
}

/* Search input field */
entry {
    background-color: transparent;
    text-color: @fg;
    placeholder-color: @fg-alt;
    placeholder: "Type to search...";
    padding: 4px;
}

/* Prompt before search input */
prompt {
    background-color: transparent;
    text-color: @fg;
    padding: 4px;
    margin: 0px 8px 0px 0px;
}

/* Grid of items */
listview {
    lines: 6;
    columns: 5;
    spacing: 20px;
    fixed-columns: true;
    background-color: transparent;
}

/* Individual item style */
element {
    orientation: vertical;
    padding: 20px 10px;
    border-radius: 8px;
    background-color: transparent;
}

/* Normal item */
element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

/* Alternate item (every second) */
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

/* Selected item */
element selected.normal {
    background-color: @bg-selected;
    text-color: @fg-selected;
}

/* Application icon */
element-icon {
    size: 64px;
    horizontal-align: 0.5;
    background-color: transparent;
}

/* Application name */
element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    margin: 8px 0px 0px 0px;
}

/* Mode switcher at the bottom */
mode-switcher {
    spacing: 20px;
    background-color: transparent;
    margin: 20px 0px 0px 0px;
}

/* Mode switcher buttons */
button {
    padding: 8px 16px;
    border-radius: 8px;
    background-color: @bg-alt;
    text-color: @fg;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

/* Selected mode button */
button selected {
    background-color: @bg-selected;
    text-color: @fg-selected;
}

/* Scrollbar styling */
scrollbar {
    width: 4px;
    border: 0;
    handle-width: 8px;
    padding: 0;
    handle-color: @bg-selected;
    background-color: @bg-alt;
    margin: 0px 0px 0px 10px;
}
