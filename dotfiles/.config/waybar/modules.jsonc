{
  // Module settings, in bar order: left, centre, right.
  // Every icon comes from the Material Design set (U+F0000+) so they share one baseline.

  // --- Left ---
  "custom/launcher": {
    "format": "󰣇",
    "on-click": "rofi -show drun",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({ workspace = 'r-1' })\"",
    "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({ workspace = 'r+1' })\"",
    "on-click": "activate",
    "all-outputs": true,
    "format": "{name}",
    "persistent-workspaces": {
      "*": 5
    }
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 45,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "󰈹  $1",
      "(.*) - Google Chrome": "󰊯  $1",
      "(.*) - Visual Studio Code": "󰨞  $1"
    }
  },

  // --- Centre ---
  "custom/weather": {
    "exec": "wttrbar --nerd --custom-indicator '{ICON} {temp_C}°'",
    "return-type": "json",
    "interval": 1800,
    "format": "{}",
    "tooltip": true
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "format-alt": "{:%d.%m.%Y  %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#dcd7ba'><b>{}</b></span>",
        "days": "<span color='#c8c093'>{}</span>",
        "weeks": "<span color='#7aa89f'><b>W{}</b></span>",
        "weekdays": "<span color='#957fb8'><b>{}</b></span>",
        "today": "<span color='#d27e99'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    },
    "interval": 1
  },

  // Audio spectrum, hidden in silence; click: previous, middle: play/pause, right: next
  "custom/cava": {
    "exec": "~/.config/waybar/scripts/cava.sh",
    "restart-interval": 5,
    "format": "󰝚 {}",
    "on-click-middle": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click": "playerctl previous"
  },

  // --- Right ---
  // Shows only while the screen is shared or the mic is in use
  "privacy": {
    "icon-size": 14,
    "modules": [
      { "type": "screenshare", "tooltip": true },
      { "type": "audio-in", "tooltip": true }
    ],
    // cava listens to the speaker monitor for the visualizer, not the mic
    "ignore": [{ "type": "audio-in", "name": "cava" }]
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": true
  },

  // CPU is always visible; hover to slide out memory, temperature, power profile and idle inhibitor
  "group/system": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "system-child",
      "transition-left-to-right": false
    },
    "modules": ["cpu", "memory", "temperature", "power-profiles-daemon", "idle_inhibitor"]
  },

  "cpu": {
    "format": "󰘚 {usage}%",
    "interval": 5,
    "on-click": "NeoHtop"
  },

  "memory": {
    "format": "󰍛 {}%",
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
    "on-click": "NeoHtop"
  },

  "temperature": {
    // hwmonN numbering changes between boots; these device paths do not (Intel, AMD)
    "hwmon-path-abs": [
      "/sys/devices/platform/coretemp.0/hwmon",
      "/sys/devices/pci0000:00/0000:00:18.3/hwmon"
    ],
    "input-filename": "temp1_input",
    "critical-threshold": 80,
    "format": "󰔏 {temperatureC}°",
    "on-click": "NeoHtop"
  },

  // Click cycles power-saver / balanced / performance
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "format-icons": {
      "default": "󰗑",
      "performance": "󰓅",
      "balanced": "󰗑",
      "power-saver": "󰌪"
    }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊"
    },
    "tooltip-format-activated": "Screen stays on",
    "tooltip-format-deactivated": "Screen locks when idle"
  },

  "hyprland/language": {
    "format": "󰌌 {}",
    "format-en": "EN",
    "format-ru": "RU",
    "tooltip-format": "{long} (Ctrl+Shift)"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-down": "brightnessctl set 5%-",
    "on-scroll-up": "brightnessctl set +5%"
  },

  "pulseaudio": {
    "scroll-step": 2,
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂰 {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\nIP: {ipaddr}\nUp: {bandwidthUpBits}  Down: {bandwidthDownBits}",
    "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}\nUp: {bandwidthUpBits}  Down: {bandwidthDownBits}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "nm-connection-editor",
    "on-click-right": "alacritty -e nmtui"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "tooltip-format": "{timeTo}",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"]
  },

  // Pending pacman/AUR updates (list in the tooltip); click to upgrade; hidden when there are none
  "custom/updates": {
    "exec": "waybar-module-pacman-updates --no-zero-output --interval-seconds 5 --network-interval-seconds 300",
    "return-type": "json",
    "format": "{icon}{}",
    "format-icons": { "has-updates": "󰚰 ", "updated": "" },
    "on-click": "alacritty -e yay"
  },

  // Notifications (SwayNC); left: panel, right: do not disturb
  "custom/notification": {
    "tooltip-format": "Left: notifications\nRight: do not disturb",
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󱅫",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
