{
  // Bar layout (Ukiyo-e: two asymmetric paper strips and a free-floating clock).
  // Module settings live in modules.jsonc, styling in style.css.
  // https://github.com/Alexays/Waybar/wiki/Configuration

  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,

  "modules-left": ["hyprland/workspaces", "mpris", "custom/cava"],

  "modules-center": ["custom/weather", "clock"],

  "modules-right": [
    "privacy",
    "group/system",
    "hyprland/language",
    "backlight",
    "pulseaudio",
    "network",
    "battery",
    "custom/updates",
    "custom/notification",
    "tray"
  ],

  "include": "~/.config/waybar/modules.jsonc"
}
