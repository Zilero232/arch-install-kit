{
  // Bar layout. Module settings live in modules.jsonc, styling in style.css.
  // https://github.com/Alexays/Waybar/wiki/Configuration

  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,

  "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],

  "modules-center": ["custom/weather", "clock", "custom/cava"],

  "modules-right": [
    "privacy",
    "tray",
    "group/system",
    "hyprland/language",
    "backlight",
    "pulseaudio",
    "network",
    "battery",
    "custom/updates",
    "custom/notification"
  ],

  "include": "~/.config/waybar/modules.jsonc"
}
