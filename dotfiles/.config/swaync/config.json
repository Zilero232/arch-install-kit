{
	"$schema": "/etc/xdg/swaync/configSchema.json",
	"ignore-gtk-theme": true,
	"cssPriority": "user",
	"positionX": "right",
	"positionY": "top",
	"layer": "overlay",
	"control-center-layer": "top",
	"layer-shell": true,
	"layer-shell-cover-screen": true,
	"control-center-exclusive-zone": true,
	"control-center-margin-top": 8,
	"control-center-margin-bottom": 8,
	"control-center-margin-right": 12,
	"control-center-margin-left": 0,
	"control-center-width": 420,
	"control-center-height": 900,
	"fit-to-screen": true,
	"notification-window-width": 380,
	"notification-2fa-action": true,
	"notification-inline-replies": true,
	"notification-body-image-height": 120,
	"notification-body-image-width": 240,
	"notification-grouping": true,
	"relative-timestamps": true,
	"image-visibility": "when-available",
	"timeout": 8,
	"timeout-low": 4,
	"timeout-critical": 15,
	"transition-time": 200,
	"keyboard-shortcuts": true,
	"hide-on-clear": false,
	"hide-on-action": true,
	"script-fail-notify": true,
	"text-empty": "All caught up",
	"widgets": [
		"title",
		"dnd",
		"buttons-grid",
		"volume",
		"backlight",
		"mpris",
		"notifications"
	],
	"widget-config": {
		"title": {
			"text": "通知  Notifications",
			"clear-all-button": true,
			"button-text": "󰗩  Clear"
		},
		"dnd": {
			"text": "Do not disturb"
		},
		"buttons-grid": {
			"buttons-per-row": 5,
			"actions": [
				{
					"label": "󰖩",
					"command": "sh -c 'swaync-client -cp; nm-connection-editor'"
				},
				{
					"label": "󰂯",
					"command": "sh -c 'swaync-client -cp; blueman-manager'"
				},
				{
					"label": "󰖔",
					"type": "toggle",
					"command": "quick_toggle.sh night",
					"update-command": "quick_toggle.sh night status"
				},
				{
					"label": "󰍭",
					"type": "toggle",
					"command": "quick_toggle.sh mic",
					"update-command": "quick_toggle.sh mic status"
				},
				{
					"label": "󰙪",
					"command": "sh -c 'swaync-client -cp; pavucontrol'"
				},
				{
					"label": "󰹑",
					"command": "sh -c 'swaync-client -cp; sleep 0.3; hyprshot -m region --raw | satty --filename -'"
				},
				{
					"label": "󰈊",
					"command": "sh -c 'swaync-client -cp; sleep 0.3; hyprpicker -a'"
				},
				{
					"label": "󰸉",
					"command": "sh -c 'swaync-client -cp; wallpaper.sh random'"
				},
				{
					"label": "󰌾",
					"command": "sh -c 'swaync-client -cp; loginctl lock-session'"
				},
				{
					"label": "󰐥",
					"command": "sh -c 'swaync-client -cp; ~/bin/power_menu.sh'"
				}
			]
		},
		"volume": {
			"label": "󰕾",
			"show-per-app": false
		},
		"backlight": {
			"label": "󰃟",
			"device": "amdgpu_bl1",
			"subsystem": "backlight",
			"min": 5
		},
		"mpris": {
			"show-album-art": "always",
			"autohide": true,
			"loop-carousel": true,
			"blacklist": [
				"kew",
				"spotify",
				"playerctld"
			]
		},
		"notifications": {
			"vexpand": true
		}
	},
	"scripts": {
		"notification-sound": {
			"exec": "notification_sound.sh",
			"urgency": "Normal",
			"app-name": "^(?!Telegram|telegram|discord|Discord|vesktop).*$",
			"run-on": "receive"
		},
		"notification-sound-critical": {
			"exec": "notification_sound.sh",
			"urgency": "Critical",
			"app-name": "^(?!Telegram|telegram|discord|Discord|vesktop).*$",
			"run-on": "receive"
		}
	}
}
